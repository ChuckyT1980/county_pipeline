25-2017 - Sandhya - if siteOptionValue is empty go to auctions page\r\n            //alert(\"siteOptionValue:\" + siteOptionValue);\r\n            if (siteOptionValue == '') siteOptionValue = \"auctions\";\r\n\r\n            var template = '/[state]/[county]/[countyID]/[siteoption]/refresh';\r\n            var vals = $(el).val().split('|');\r\n            var url = template.replace('[state]', vals[0]).replace('[county]', vals[1]).replace('[siteoption]', siteOptionValue).replace('[countyID]', vals[2]);\r\n            //alert('SmartAdminLayout_refreshCounty - 1 ' + url);\r\n            if (currentUrl.toString().split(\"/\").length < 6) {\r\n                url = '/' + vals[2] + '/' + currentUrl.toString().split(\"/\")[4];\r\n                //alert('SmartAdminLayout_refreshCounty - 2 ' + url);\r\n            }\r\n\r\n            window.location.href = url;\r\n        }\r\n\r\n        function refreshSelectedCounty(countyValue) {\r\n            if (countyValue != '') {\r\n                var currentUrl = window.location.href;\r\n                var siteOptionValue = currentUrl.toString().split(\"/\")[6]; //alert(siteOptionValue);\r\n                var template = '/[state]/[county]/[countyID]/[siteoption]/refresh';\r\n                var vals = countyValue.split('|');\r\n                var url = template.replace('[state]', vals[0]).replace('[county]', vals[1]).replace('[siteoption]', siteOptionValue).replace('[countyID]', vals[2]);\r\n                window.location.href = url;\r\n            }\r\n\r\n        }\r\n    </script>\r\n    <!-- 10/16/2018 - Sandhya - BEGIN Beamer Code -->\r\n    <script>\r\n        var beamer_config = {\r\n            product_id: 'rcSAhGek5973', //DO NOT CHANGE: This is your product code on Beamer\r\n            button_position: 'bottom-right', /*Position for the default notification button. Other possible values are 'bottom-left', 'top-left' and 'top-right'.*/\r\n            top: 10, // change position of bouncing icon - desired closer to
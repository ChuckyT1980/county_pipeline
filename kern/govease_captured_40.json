nction () { });\r\n    </script>\r\n\r\n    \r\n    <script type=\"text/javascript\">\r\n\r\n         $(document).ready(function () {\r\n             //if count is not selected\r\n             var ID = $(\"#CountyID\").val();\r\n             if (ID == null || ID == 0) {\r\n                 // $('#dialog-browse').dialog('open');\r\n                 $('#openCountyModal').click();\r\n             }\r\n             // $('#TimeZoneJSCounty').val(new Date().toString());\r\n             $('#TimeZoneJSPop').val(new Date().toString());\r\n             $('#TimeZoneClientJSPop').val(new Date().toString());\r\n\r\n             $('#MultiSearchBox').keypress(function (event) {\r\n                 var keycode = (event.keyCode ? event.keyCode : event.which);\r\n                 if (keycode == '13') {\r\n                     SearchAuctions();\r\n                 }\r\n             });\r\n             $('#MultiSearchBoxMobile').keypress(function (event) {\r\n                 var keycode = (event.keyCode ? event.keyCode : event.which);\r\n                 if (keycode == '13') {\r\n                     SearchAuctions();\r\n                 }\r\n             });\r\n             $(\"#MultiSearchBox\").bind(\"mouseup\", function (e) {\r\n                 var $input = $(this),\r\n                     oldSearchValue = $input.val();\r\n                 if (oldSearchValue == \"\") return false;\r\n                 setTimeout(function () {\r\n                     var newSearchValue = $input.val();\r\n\r\n                     if (newSearchValue == \"\") {\r\n                         // submit form with cleared search keyword\r\n                         SearchAuctions();\r\n                     }\r\n                 }, 1);\r\n             });\r\n\r\n         });\r\n\r\n         onload = function () {\r\n             var e = document.getElementById(\"refreshed\");\r\n             if (e.value == \"no\") { e.value = \"yes\"; }\r\n             else { e.value = \"no\"; location.reload(true); }\r\n         }\r\n\r\n         window.onpopstate = function(e){\r\n             if(e.state !== null){\r\n                 // state data available\r\n                 // load page using state data\r\n                 var x = document.getElementById(\"refreshed\");\r\n                 if (x.value == \"no\") { x.value = \"yes\"; }\r\n                 else { x.value = \"no\"; location.reload(true); }\r\n             }\r\n         }\r\n\r\n\r\n        function gotoPage(pageNumber, pageSize, sortColumn) {\r\n\r\n            var container = $('#countyAuctions');\r\n\r\n            var countySlug = \"cocostillatread\";\r\n            var stateAbbr = \"CO\";\r\n            var countyID = 1435;\r\n            if (!pageNumber) pageNumber = 1;\r\n            if (!pageSize) pageSize = set(50);\r\n            var orderBy = (sortColumn) ? $(sortColumn).attr('data-order-by') : $(container).attr('data-order-by');\r\n            var orderDesc = (sortColumn) ? $(sortColumn).attr('data-order-desc') : $(container).attr('data-order-desc');\r\n\r\n            var success = function (response, textStatus, xhr, userContext) {\r\n                if (response.Result) {\r\n                    $(container).html(response.Grid);\r\n                    InitializeWatchlistTooltips(); // in govease-common.js\r\n\r\n                    $(container).attr('data-order-by', userContext.orderBy).attr('data-order-desc', userContext.orderDesc);\r\n                    $(container).find('[data-order-by=\"' + userContext.orderBy + '\"]').attr('data-order-desc', (userContext.orderDesc == 1) ? 0 : 1);\r\n\r\n                    // 09-26-2018 - Sandhya - Add arrow to header when sorted. Change color of the row field with data-col-name = <currently sorted column>\r\n                    $(container).find('[data-order-by=\"' + userContext.orderBy + '\"]').addClass('sorted');\r\n                    $(container).find('[data-col-name=\"' + userContext.orderBy + '\"]').addClass('sorted-col');\r\n\r\n                    $('[data-auction-id][data-control-id=\"max-bid\"]').keypress(function (event) {\r\n                        var auctionId = $(this).attr('data-auction-id');\r\n                        var keycode = (event.keyCode ? event.keyCode : event.which);\r\n                        if (keycode == '13') {\r\n                            $('[data-auction-id=\"' + auctionId + '\"][data-control-id=\"max-bid-button\"]').click();\r\n                        }\r\n                    });\r\n                }\r\n\r\n                clearTimeout(userContext.timeout);\r\n                $('#loading').fadeOut('fast');\r\n            }\r\n\r\n            var userContext = { timeout: setTimeout(function () { $('#loading').fadeIn('fast'); }, 500), orderBy: orderBy, orderDesc: orderDesc };\r\n\r\n            var stateObj = {pageNumber : pageNumber, pageSize : pageSize, sortColumn : sortColumn};\r\n\r\n            if (sortColumn == null) window.history.pushState(stateObj, 'Title', '/' + stateAbbr + '/' + countySlug + '/' + countyID + '/browse/'+pageNumber);\r\n\r\n            ajaxCall('/OpenAuction/RefreshStandardAuctions', { countyId: set(1435), criteria: set({\"PostUrl\":\"/CO/cocostillatread/1435/browsestandard\",\"ResetUrl\":\"/CO/cocostillatread/1435/browsestandard\",\"StateAbbr\":\"CO\",\"CountySlug\":\"cocostillatread\",\"CountyID\":1435,\"ParcelNumber\":\"\",\"CountyIdList\":[],\"Location\":\"\",\"OwnerName\":\"\",\"FaceValueFrom\":null,\"FaceValueTo\":null,\"WatchList\":false,\"AuctionLienFilter\":null,\"MultiSearchBox\":null}), pageNumber: pageNumber, pageSize: pageSize, orderBy: orderBy, orderDesc: orderDesc, stateAbbr: stateAbbr }, success, null, userContext);\r\n        }\r\n\r\n         // 09-20-2018 - Sandhya - GTA-25 : Export Auctions functionality\r\n        function exportAuctions() {\r\n            $(\".ForExport\").val(\"1\");\r\n            $(\".AuctionFilter\").click();\r\n        }\r\n\r\n        function SearchAuctions() {\r\n            var FaceValueFrom = $('#hdFaceValueFrom').val().replace(/[a-zA-Z,$]/gi, '');\r\n            var FaceValueTo = $('#hdFaceValueTo').val().replace(/[a-zA-Z,$]/gi, '');\r\n            var MultiSearchBox = $('#MultiSearchBox').val();\r\n\r\n            if (parseFloat(FaceValueFrom) > parseFloat(FaceValueTo)) {\r\n                var tempFrom = FaceValueFrom;\r\n\r\n                FaceValueFrom = FaceValueTo;\r\n                FaceValueTo = tempFrom;\r\n            }\r\n            $('#hdFaceValueFrom').val(FaceValueFrom);\r\n            $('#hdFaceValueTo').val(FaceValueTo);\r\n            $('#hdMultiSearchBox').val(MultiSearchBox);\r\n\r\n            $(\".ForExport\").val(\"0\");\r\n            $(\".AuctionFilter\").click();\r\n        }\r\n\r\n        function SearchAuctionsWithFilters() {\r\n            var FaceValueFrom = $('#SearchCriteria_FaceValueFrom').val().replace(/[a-zA-Z,$]/gi, '');\r\n            var FaceValueTo = $('#SearchCriteria_FaceValueTo').val().replace(/[a-zA-Z,$]/gi, '');\r\n\r\n            if (parseFloat(FaceValueFrom) > parseFloat(FaceValueTo)) {\r\n                var tempFrom = FaceValueFrom;\r\n\r\n                FaceValueFrom = FaceValueTo;\r\n                FaceValueTo = tempFrom;\r\n            }\r\n\r\n            $('#SearchCriteria_FaceValueFrom').val(FaceValueFrom);\r\n            $('#SearchCriteria_FaceValueTo').val(FaceValueTo);\r\n\r\n            $('#hdFaceValueFrom').val(FaceValueFrom);\r\n            $('#hdFaceValueTo').val(FaceValueTo);\r\n\r\n            $('#hdWatchList').val(document.getElementById('SearchCriteria_WatchList').checked);\r\n\r\n            $(\".ForExport\").val(\"0\");\r\n            $(\".AuctionFilter\").click();\r\n        }\r\n\r\n        function clearSearchBox() {\r\n\r\n            $('#SearchCriteria_FaceValueFrom').val(\"\");\r\n            $('#SearchCriteria_FaceValueTo').val(\"\");\r\n\r\n            document.getElementById('SearchCriteria_WatchList').checked = false;\r\n\r\n        }\r\n\r\n        function SearchAuctionsMobile() {\r\n            var FaceValueFrom = $('#hdFaceValueFrom').val().replace(/[a-zA-Z,$]/gi, '');\r\n            var FaceValueTo = $('#hdFaceValueTo').val().replace(/[a-zA-Z,$]/gi, '');\r\n            var MultiSearchBox = $('#MultiSearchBoxMobile').val();\r\n\r\n            if (parseFloat(FaceValueFrom) > parseFloat(FaceValueTo)) {\r\n                var tempFrom = FaceValueFrom;\r\n                FaceValueFrom = FaceValueTo;\r\n                FaceValueTo = tempFrom;\r\n            }\r\n            $('#hdFaceValueFrom').val(FaceValueFrom);\r\n            $('#hdFaceValueTo').val(FaceValueTo);\r\n            $('#hdMultiSearchBox').val(MultiSearchBox);\r\n            $(\".ForExport\").val(\"0\");\r\n            $(\".AuctionFilter\").click();\r\n        }\r\n\r\n        function closeMobilePopover() {\r\n            $(\"#popoverMobileFilter\").popover('hide');\r\n        }\r\n\r\n        function closePopover() {\r\n            $(\"#popoverFilter\").popover('hide');\r\n            }\r\n\r\n\r\n    </script>\r\n\r\n</body>\r\n<!--END Body-->\r\n\r\n</html>\r\n\r\n"
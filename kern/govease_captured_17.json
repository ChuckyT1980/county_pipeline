"@import url(https://fonts.googleapis.com/css?family=Open+Sans:400,700);\r\n@import url(https://fonts.googleapis.com/css?family=Open+Sans+Condensed:300,700);\r\n\r\nhtml {\r\n    /*background-color: #e2e2e2;*/\r\n    margin: 0;\r\n    padding: 0;\r\n    /* 03-06-2017 - Sandhya - some styles in site.css conflicting with SmartAdmin styles. Site.css copied to GovEaseSite.css & offending classes have been commented out.*/\r\n    /*height: 100%;*/\r\n}\r\n\r\nbody {\r\n    background-color: #fff;\r\n    color: #333;\r\n    font-size: .9em;\r\n    font-size: 14px;\r\n    /*font-family: 'Open Sans', Arial, sans-serif; Removed in GEMP 333 to standardize font-family*/\r\n    margin: 0;\r\n    padding: 0;\r\n    height: 100%;\r\n}\r\n\r\nbody, input, select {\r\n    /*font-family: 'Open Sans', Arial, sans-serif; Removed in GEMP 333 to standardize font-family*/\r\n}\r\n\r\nheader {\r\n    /*position: absolute;\r\n    top: 0px;\r\n    left: 0px;\r\n    right: 0px;\r\n    height: 50px;*/\r\n}\r\n\r\n/*div {\r\n    box-sizing: border-box;\r\n}*/\r\n\r\ndiv#body {\r\n    /*display: table;\r\n        width: 100%;*/\r\n    /*position: absolute;\r\n        top: 50px;\r\n        left: 0px;\r\n        right: 0px;\r\n        bottom: 50px;*/\r\n}\r\n\r\ndiv#body-nav {\r\n    display: table-cell;\r\n    width: 200px;\r\n    background-color: #34495e;\r\n    color: #ffffff;\r\n    font-size: .9em;\r\n    padding: 5px 10px;\r\n    box-sizing: border-box;\r\n}\r\n\r\n    div#body-nav a {\r\n        color: #ffffff;\r\n    }\r\n\r\ndiv#body-content {\r\n    /*display: table-cell;*/\r\n    vertical-align: top;\r\n    box-sizing: border-box;\r\n    padding: 10px 10px 20px 10px;\r\n}\r\n\r\n    div#body-content .content {\r\n        background: white;\r\n        margin: 10px 0 0 0;\r\n        padding: 10px;\r\n    }\r\n\r\n    div#body-content .content-grid {\r\n        margin: 10px 0 0 0;\r\n    }\r\n\r\n        div#body-content .content-grid > .content-grid-view {\r\n            display: table;\r\n            margin: 0 0 0 auto;\r\n        }\r\n\r\n            div#body-content .content-grid > .content-grid-view > .content-grid-view-label,\r\n            div#body-content .content-grid > .content-grid-view > .content-grid-view-item {\r\n                display: table-cell;\r\n            }\r\n\r\n            div#body-content .content-grid > .content-grid-view > .content-grid-view-item {\r\n                background-color: white;\r\n                padding: 2px 6px;\r\n                border-radius: 2px;\r\n                border: 1px solid #ccc;\r\n                border-bottom-left-radius: 0;\r\n                border-bottom-right-radius: 0;\r\n                border-bottom: none;\r\n            }\r\n\r\n        div#body-content .content-grid > .content-grid-content {\r\n            background: white;\r\n            padding: 10px;\r\n        }\r\n\r\n            div#body-content .content-grid > .content-grid-content.content-grid-content-autosize {\r\n                display: inline-block;\r\n            }\r\n\r\n/* Preview Auction effects*/\r\n/*div .nobid {\r\n        background-color: #FFFFFF !important;\r\n    }\r\n\r\n    div .winning {\r\n        background-color: rgba(52, 250, 135, 0.50) !important;\r\n    }\r\n\r\n    div .loosing {\r\n        background-color: rgba(250, 77, 77, 0.50) !important;\r\n    }\r\n\r\n        div .loosing:hover > div {\r\n            background-color: rgba(237, 75, 75, 0.50) !important;\r\n        }\r\n\r\n    div .winning:hover > div {\r\n        background-color: rgba(53, 235, 129, 0.50) !important;\r\n    }\r\n\r\n    div .nobid:hover > div {\r\n        background-color: rgba(186, 208, 243, 0.50) !important;\r\n    }*/\r\n\r\nfooter {\r\n    /*position: absolute;\r\n    bottom: 0px;\r\n    left: 0px;\r\n    right: 0px;\r\n    height: 50px;*/\r\n}\r\n\r\na {\r\n    color: #333;\r\n    outline: none;\r\n    padding-left: 3px;\r\n    padding-right: 3px;\r\n    text-decoration: underline;\r\n}\r\n    /* Removed with GEMP 362 all hover backgrouund colors on new template - replace with nmew styling when applied*/\r\n\r\n    a:link, a:visited,\r\n    a:active, a:hover {\r\n        /*color: #333;*/\r\n    }\r\n\r\n    a:hover {\r\n        /*background-color: #c7d1d6;*/\r\n    }\r\n\r\n\r\n    a > span:hover {\r\n        color: #20638f;\r\n    }\r\n/* GEMP 327 - added to cascade thru and in page-sidebar not alter - avoid double negation with :not */\r\n.page-sidebar a > span:hover {\r\n    color: white;\r\n}\r\n\r\na.noHoverColor:hover {\r\n    background-color: transparent;\r\n}\r\n\r\na.linkasbutton, a.linkasbutton:visited, a.linkasbutton:active, a.linkasbutton:hover {\r\n    background-color: transparent;\r\n    text-decoration: none;\r\n    color: white;\r\n    min-width: 90px;\r\n    padding: 10px 6px;\r\n}\r\n\r\na.footerLink {\r\n    color: white;\r\n    text-decoration: underline;\r\n}\r\n\r\n    a.footerLink:hover {\r\n        color: white;\r\n        text-decoration: none;\r\n        background-color: transparent;\r\n    }\r\n\r\n    a.footerLink:link, a.footerLink:visited, a.footerLink:active {\r\n        color: white;\r\n    }\r\n\r\n\r\nheader, footer, hgroup,\r\nnav, section {\r\n    display: block;\r\n}\r\n\r\n.minified #divNavCountyInfo, .minified #divNavUserName {\r\n    display: none;\r\n}\r\n\r\nmark {\r\n    background-color: #a6dbed;\r\n    padding-left: 5px;\r\n    padding-right: 5px;\r\n}\r\n\r\n.float-left {\r\n    float: left;\r\n}\r\n\r\n.float-right {\r\n    float: right;\r\n}\r\n\r\n.clear-fix:after {\r\n    content: \".\";\r\n    clear: both;\r\n    display: block;\r\n    height: 0;\r\n    visibility: hidden;\r\n}\r\n\r\nh1, h2, h3,\r\nh4, h5, h6 {\r\n    color: #000;\r\n    margin-bottom: 0;\r\n    padding-bottom: 0;\r\n}\r\n\r\nh1 {\r\n    font-size: 2em;\r\n}\r\n\r\nh2 {\r\n    font-size: 1.75em;\r\n}\r\n\r\nh3 {\r\n    font-size: 1.2em;\r\n}\r\n\r\nh4 {\r\n    font-size: 1.1em;\r\n}\r\n\r\nh5, h6 {\r\n    font-size: 1em;\r\n}\r\n\r\n    h5 a:link, h5 a:visited, h5 a:active {\r\n        padding: 0;\r\n        text-decoration: none;\r\n    }\r\n\r\n/* main layout\r\n----------------------------------------------------------*/\r\n.content-wrapper {\r\n    margin: 0 auto;\r\n    max-width: 1500px;\r\n}\r\n\r\n#body {\r\n    /*background-color: #ffffff; /* 07/12/2017 - Sandhya - Commented out #efeeef;\r\n    clear: both;\r\n    /*padding-bottom: 35px;*/\r\n}\r\n\r\n\r\n.main-content {\r\n    /*padding-left: 10px;*/\r\n    /*padding-top: 30px;*/\r\n}\r\n\r\n.featured + .main-content {\r\n    background: url(\"../Images/heroAccent.png\") no-repeat;\r\n}\r\n\r\nheader .content-wrapper {\r\n    background-color: #2980b9;\r\n}\r\n\r\nfooter {\r\n    clear: both;\r\n    background-color: #e2e2e2;\r\n    font-size: .8em;\r\n    height: 100px;\r\n}\r\n\r\n\r\n/* site title\r\n----------------------------------------------------------*/\r\n.site-title {\r\n    color: #c8c8c8;\r\n    font-family: Rockwell, Consolas, \"Courier New\", Courier, monospace;\r\n    font-size: 2.3em;\r\n    margin: 0;\r\n}\r\n\r\n    .site-title a, .site-title a:hover, .site-title a:active {\r\n        background: none;\r\n        color: #c8c8c8;\r\n        outline: none;\r\n        text-decoration: none;\r\n    }\r\n\r\n\r\n/* login\r\n----------------------------------------------------------*/\r\n#login {\r\n    display: block;\r\n    font-size: .85em;\r\n    margin: 0 0 10px;\r\n    margin: 0 10px 0 0;\r\n    text-align: right;\r\n    color: #d3dce0;\r\n}\r\n\r\n    #login a {\r\n        background-color: #d3dce0;\r\n        margin-left: 10px;\r\n        margin-right: 3px;\r\n        padding: 2px 3px;\r\n        text-decoration: none;\r\n    }\r\n\r\n        #login a.link {\r\n            background-color: #2980b9;\r\n            color: #d3dce0;\r\n            margin-left: 10px;\r\n            margin-right: 3px;\r\n            padding: 2px 3px;\r\n            text-decoration: none;\r\n        }\r\n\r\n        #login a.username {\r\n            background: none;\r\n            margin: 0;\r\n            padding: 0;\r\n            text-decoration: underline;\r\n            color: #d3dce0;\r\n        }\r\n\r\n    #login ul {\r\n        margin: 0;\r\n    }\r\n\r\n    #login li {\r\n        display: inline;\r\n        list-style: none;\r\n    }\r\n\r\n\r\n/* menu\r\n----------------------------------------------------------*/\r\nul#menu {\r\n    font-size: 1.3em;\r\n    font-weight: 600;\r\n    margin: 0 0 5px;\r\n    padding: 0;\r\n    text-align: right;\r\n}\r\n\r\n    ul#menu li {\r\n        display: inline;\r\n        list-style: none;\r\n        padding-left: 15px;\r\n    }\r\n\r\n        ul#menu li a {\r\n            background: none;\r\n            color: #999;\r\n            text-decoration: none;\r\n        }\r\n\r\n            ul#menu li a:hover {\r\n                color: #333;\r\n                text-decoration: none;\r\n            }\r\n\r\n\r\n/* page elements\r\n----------------------------------------------------------*/\r\nul.dropdown-menu li.a {\r\n    text-decoration: none;\r\n}\r\n\r\n.restrictComboWidth .custom-combobox {\r\n    max-width: 800px;\r\n}\r\n\r\n/* featured */\r\n.featured {\r\n    background-color: #fff;\r\n}\r\n\r\n    .featured .content-wrapper {\r\n        background-color: #7ac0da;\r\n        background-image: -ms-linear-gradient(left, #7ac0da 0%, #a4d4e6 100%);\r\n        background-image: -o-linear-gradient(left, #7ac0da 0%, #a4d4e6 100%);\r\n        background-image: -webkit-gradient(linear, left top, right top, color-stop(0, #7ac0da), color-stop(1, #a4d4e6));\r\n        background-image: -webkit-linear-gradient(left, #7ac0da 0%, #a4d4e6 100%);\r\n        background-image: linear-gradient(left, #7ac0da 0%, #a4d4e6 100%);\r\n        color: #3e5667;\r\n        padding: 20px 40px 30px 40px;\r\n    }\r\n\r\n    .featured hgroup.title h1, .featured hgroup.title h2 {\r\n        color: #fff;\r\n    }\r\n\r\n    .featured p {\r\n        font-size: 1.1em;\r\n    }\r\n\r\n/* page titles */\r\nhgroup.title {\r\n    margin-bottom: 10px;\r\n}\r\n\r\n    hgroup.title h1, hgroup.title h2 {\r\n        display: inline;\r\n    }\r\n\r\n    hgroup.title h2 {\r\n        font-weight: normal;\r\n        margin-left: 3px;\r\n    }\r\n\r\n/* features */\r\nsection.feature {\r\n    width: 300px;\r\n    float: left;\r\n    padding: 10px;\r\n}\r\n\r\n/* ordered list */\r\nol.round {\r\n    list-style-type: none;\r\n    padding-left: 0;\r\n}\r\n\r\n    ol.round li {\r\n        margin: 25px 0;\r\n        padding-left: 45px;\r\n    }\r\n\r\n        ol.round li.zero {\r\n            background: url(\"../Images/orderedList0.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.one {\r\n            background: url(\"../Images/orderedList1.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.two {\r\n            background: url(\"../Images/orderedList2.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.three {\r\n            background: url(\"../Images/orderedList3.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.four {\r\n            background: url(\"../Images/orderedList4.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.five {\r\n            background: url(\"../Images/orderedList5.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.six {\r\n            background: url(\"../Images/orderedList6.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.seven {\r\n            background: url(\"../Images/orderedList7.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.eight {\r\n            background: url(\"../Images/orderedList8.png\") no-repeat;\r\n        }\r\n\r\n        ol.round li.nine {\r\n            background: url(\"../Images/orderedList9.png\") no-repeat;\r\n        }\r\n\r\n/* content */\r\narticle {\r\n    float: left;\r\n    width: 70%;\r\n}\r\n\r\n/* 03-06-2017 - Sandhya - some styles in site.css conflicting with SmartAdmin styles. Site.css copied to GovEaseSite.css & offending classes have been commented out.*/\r\n/*aside\r\n{\r\n    float: right;\r\n    width: 25%;\r\n}\r\n\r\n    aside ul\r\n    {\r\n        list-style: none;\r\n        padding: 0;\r\n    }\r\n\r\n        aside ul li\r\n        {\r\n            background: url(\"../Images/bullet.png\") no-repeat 0 50%;\r\n            padding: 2px 0 2px 20px;\r\n        }*/\r\n\r\n.label {\r\n    font-weight: 700;\r\n}\r\n\r\n\r\n\r\n\r\n#socialLoginForm {\r\n    margin-left: 40px;\r\n    float: left;\r\n    width: 40%;\r\n}\r\n\r\n    #socialLoginForm h2 {\r\n        margin-bottom: 5px;\r\n    }\r\n\r\n#socialLoginList button {\r\n    margin-bottom: 12px;\r\n}\r\n\r\n#logoutForm {\r\n    display: inline;\r\n}\r\n\r\n/* contact */\r\n.contact h3 {\r\n    font-size: 1.2em;\r\n}\r\n\r\n.contact p {\r\n    margin: 5px 0 0 10px;\r\n}\r\n\r\n.contact iframe {\r\n    border: 1px solid #333;\r\n    margin: 5px 0 0 10px;\r\n}\r\n\r\n/* forms */\r\nfieldset {\r\n    border: none;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n    fieldset legend {\r\n        display: none;\r\n    }\r\n\r\n    fieldset ol {\r\n        padding: 0;\r\n        list-style: none;\r\n    }\r\n\r\n        fieldset ol li {\r\n            padding-bottom: 5px;\r\n        }\r\n\r\nlabel {\r\n    display: block;\r\n    font-size: 1em;\r\n    /*font-weight: 600; 07/08/20 removed as part of css transition to new template and away from custom css */\r\n}\r\n\r\n    label.checkbox {\r\n        display: inline;\r\n    }\r\n\r\n\r\n/* Labels in User Profile page */\r\n.form-section.user-form label {\r\n    font-weight: 500;\r\n    font-size: 13px;\r\n    color: #333;\r\n}\r\n\r\n/* Rows in User Profile page */\r\n.form-section.user-form .form-row {\r\n    padding-top: 3px;\r\n    padding-bottom: 3px;\r\n}\r\n\r\n\r\n/* Form Header in User Profile page */\r\n.form-header {\r\n    color: #333;\r\n    border: 1px solid #c2c2c2;\r\n    background: #fafafa;\r\n    border-bottom: none;\r\n    padding-left: 5px;\r\n    padding-top: 3px;\r\n    padding-bottom: 3px;\r\n    font-size: 20px;\r\n    font-weight: bolder;\r\n}\r\n/* Form Sub Header in User Profile page */\r\n.form-sub-header {\r\n    color: #333;\r\n    border: 1px solid #c2c2c2;\r\n    border-top: none;\r\n    border-left: none;\r\n    border-right: none;\r\n    padding-top: 5px;\r\n    padding-bottom: 5px;\r\n    font-size: 14px;\r\n    font-weight: bolder;\r\n    margin-bottom: 10px;\r\n    margin-left: 3px;\r\n}\r\n\r\ntextarea {\r\n    font-family: inherit;\r\n    width: 500px;\r\n}\r\n\r\n\r\n/* info and errors */\r\n.message-info {\r\n    border: 1px solid;\r\n    clear: both;\r\n    padding: 10px 20px;\r\n}\r\n\r\n.message-error {\r\n    clear: both;\r\n    color: #e80c4d;\r\n    font-size: 1.1em;\r\n    font-weight: bold;\r\n    /*margin: 20px 0 10px 0;*/\r\n}\r\n\r\n.message-success {\r\n    color: #7ac0da;\r\n    font-size: 1.3em;\r\n    font-weight: bold;\r\n    /*margin: 20px 0 10px 0;*/\r\n}\r\n\r\n.error {\r\n    color: #e80c4d;\r\n}\r\n\r\n.popover-warning {\r\n    background-color: #ffd2d3;\r\n    border-width: 1px;\r\n    border-color: #df8f90\r\n}\r\n\r\n.popover-error {\r\n    background-color: #ffd2d3;\r\n    border-width: 1px;\r\n    border-color: #df8f90\r\n}\r\n\r\n.popover-success {\r\n    background-color: #d4ffcd;\r\n    border-width: 1px;\r\n    border-color: #9adf8f;\r\n}\r\n\r\n.popover-info {\r\n    background-color: #d4ffcd;\r\n    border-width: 1px;\r\n    border-color: #9adf8f;\r\n}\r\n\r\n/* styles for validation helpers */\r\n.field-validation-error {\r\n    color: #e80c4d;\r\n    font-weight: bold;\r\n}\r\n\r\n.field-validation-valid {\r\n    display: none;\r\n}\r\n\r\n\r\n.validation-summary-errors {\r\n    color: #e80c4d;\r\n    font-weight: bold;\r\n    font-size: 1.1em;\r\n}\r\n\r\n.validation-summary-valid {\r\n    display: none;\r\n}\r\n\r\n\r\n/* tables\r\n----------------------------------------------------------*/\r\ntable {\r\n    border-collapse: collapse;\r\n    border-spacing: 0;\r\n    margin-top: 0.75em;\r\n    border: 0 none;\r\n}\r\n\r\nth {\r\n    font-size: 1em;\r\n    text-align: left;\r\n    border: none 0px;\r\n    padding-left: 0;\r\n}\r\n\r\n    th a {\r\n        display: block;\r\n        position: relative;\r\n    }\r\n\r\n        th a:link, th a:visited, th a:active, th a:hover {\r\n            color: #333;\r\n            font-weight: 600;\r\n            text-decoration: none;\r\n            padding: 0;\r\n        }\r\n\r\n        th a:hover {\r\n            color: #000;\r\n        }\r\n\r\n    th.asc a, th.desc a {\r\n        margin-right: .75em;\r\n    }\r\n\r\n        th.asc a:after, th.desc a:after {\r\n            display: block;\r\n            position: absolute;\r\n            right: 0em;\r\n            top: 0;\r\n            font-size: 0.75em;\r\n        }\r\n\r\n        th.asc a:after {\r\n            content: '\u25b2';\r\n        }\r\n\r\n        th.desc a:after {\r\n            content: '\u25bc';\r\n        }\r\n\r\ntd {\r\n    padding: 0.25em 2em 0.25em 0em;\r\n    border: 0 none;\r\n}\r\n\r\ntr.pager td {\r\n    padding: 0 0.25em 0 0;\r\n}\r\n\r\n\r\n#search-box {\r\n    float: left;\r\n    margin: 0 0 10px 0;\r\n    background-color: #ffffff;\r\n    border: 1px solid #e2e2e2;\r\n}\r\n\r\n    #search-box #search-box-text {\r\n        border: none;\r\n        margin: 0;\r\n        vertical-align: middle;\r\n    }\r\n\r\n    #search-box #search-box-img {\r\n        vertical-align: middle;\r\n        margin-right: 5px;\r\n    }\r\n\r\n#search-box-text::-webkit-input-placeholder {\r\n    font-size: .7em;\r\n    vertical-align: middle;\r\n    line-height: 22px;\r\n}\r\n\r\n#search-box-text:-moz-placeholder { /* Firefox 18- */\r\n    font-size: .7em;\r\n    vertical-align: middle;\r\n    line-height: 22px;\r\n}\r\n\r\n#search-box-text::-moz-placeholder { /* Firefox 19+ */\r\n    font-size: .7em;\r\n    vertical-align: middle;\r\n    line-height: 22px;\r\n}\r\n\r\n#search-box-text:-ms-input-placeholder {\r\n    font-size: .7em;\r\n    vertical-align: middle;\r\n    line-height: 22px;\r\n}\r\n\r\n\r\n#myPurchaseSummary.my-stats,\r\n#myTotalSummary.my-stats {\r\n    display: table;\r\n    background-color: #ffffff;\r\n    padding: 8px 0px;\r\n    margin: 0 0 0 auto;\r\n}\r\n\r\n    #myPurchaseSummary.my-stats:after,\r\n    #myTotalSummary.my-stats:after {\r\n        content: '';\r\n        display: block;\r\n        clear: both;\r\n    }\r\n\r\n#myPurchaseSummary .my-stats-options,\r\n#myTotalSummary .my-stats-options {\r\n    display: block;\r\n}\r\n\r\n    #myPurchaseSummary .my-stats-options .stat-item,\r\n    #myTotalSummary .my-stats-options .stat-item {\r\n        display: block;\r\n        text-align: right;\r\n        padding: 0px 20px 5px;\r\n    }\r\n\r\n        /* 07-12-2017 - Sandhya - new UI changes: Dashboard - change color for inactive option */\r\n        #myPurchaseSummary .my-stats-options .stat-item a:link,\r\n        #myTotalSummary .my-stats-options .stat-item a:link {\r\n            color: #a3a2a2;\r\n        }\r\n\r\n/* 07-12-2017 - Sandhya - new UI changes: Dashboard - change color for active option */\r\n#myPurchaseSummary:not(.all-counties) .my-stats-options .stat-item a.single-county,\r\n#myPurchaseSummary.all-counties .my-stats-options .stat-item a.all-counties,\r\n#myTotalSummary:not(.all-counties) .my-stats-options .stat-item a.single-county,\r\n#myTotalSummary.all-counties .my-stats-options .stat-item a.all-counties {\r\n    font-weight: bold;\r\n    text-decoration: none;\r\n    color: #a2b8c4;\r\n}\r\n\r\n\r\n#myPurchaseSummary .my-stats-data,\r\n#myTotalSummary .my-stats-data {\r\n}\r\n\r\n    #myPurchaseSummary .my-stats-data.single-county,\r\n    #myTotalSummary .my-stats-data.single-county {\r\n    }\r\n\r\n    #myPurchaseSummary .my-stats-data.all-counties,\r\n    #myTotalSummary .my-stats-data.all-counties {\r\n    }\r\n\r\n\r\n#myPurchaseSummary.all-counties .my-stats-data.single-county,\r\n#myTotalSummary.all-counties .my-stats-data.single-county {\r\n    display: none !important;\r\n}\r\n\r\n#myPurchaseSummary:not(.all-counties) .my-stats-data.all-counties,\r\n#myTotalSummary:not(.all-counties) .my-stats-data.all-counties {\r\n    display: none !important;\r\n}\r\n\r\n\r\n/* Notifications */\r\n.flash-yellow {\r\n    transition: background 0.25s ease-in-out;\r\n    -ms-transition: background 0.25s ease-in-out;\r\n    -webkit-transition: background 0.25s ease-in-out;\r\n    background-color: yellow !important;\r\n}\r\n\r\n.watch-list {\r\n    cursor: pointer;\r\n    display: inline-block;\r\n}\r\n\r\n    .watch-list .watch-list-image {\r\n        background-image: url(/images/star-empty.png);\r\n        background-size: 70%;\r\n        background-repeat: no-repeat;\r\n        background-position: center;\r\n        width: 32px;\r\n        height: 30px;\r\n        display: inline-block;\r\n        vertical-align: text-bottom;\r\n    }\r\n\r\n    .watch-list.filled .watch-list-image {\r\n        background-image: url(/images/star-filled.png);\r\n    }\r\n\r\n    .watch-list .watch-list-text {\r\n        display: inline-block;\r\n    }\r\n\r\n.watch-list-add, .watch-list-remove {\r\n    display: none;\r\n}\r\n\r\nselect.classic {\r\n    background-image: linear-gradient(45deg, transparent 50%, blue 50%), linear-gradient(135deg, blue 50%, transparent 50%), linear-gradient(to right, skyblue, skyblue);\r\n    background-position: calc(100% - 15px), calc(100% - 10px), 100% 0;\r\n    background-size: 5px 5px, 5px 5px, 2.5em 2.5em;\r\n    background-repeat: no-repeat;\r\n}\r\n\r\na.filter, a.filter:visited, a.filter:hover, a.filter:active, a.filter:link {\r\n    color: #a2b8c4;\r\n    text-decoration: none;\r\n    background-color: white;\r\n    font-size: 14px;\r\n    font-weight: bold;\r\n}\r\n\r\n#header-profile-info {\r\n    display: inline-block;\r\n    float: right;\r\n    min-width: 450px;\r\n}\r\n\r\n#header-username {\r\n    display: inline-block;\r\n    min-width: 400px;\r\n    text-align: right;\r\n    color: #455a64;\r\n    font-weight: bold;\r\n}\r\n\r\ndiv.faq p {\r\n    padding-top: 10px;\r\n}\r\n\r\n    div.faq p span {\r\n        color: #2196f3;\r\n        font-weight: bold;\r\n    }\r\n\r\n@media only screen and (min-width: 851px) {\r\n    div#mobile-menu-toggle {\r\n        display: none;\r\n    }\r\n\r\n    div#body-nav {\r\n        display: table-cell !important;\r\n    }\r\n}\r\n\r\n/********************\r\n*   Mobile Styles   *\r\n********************/\r\n@media only screen and (max-width: 850px) {\r\n    div#body {\r\n        position: relative;\r\n    }\r\n\r\n    div#mobile-menu-toggle {\r\n        display: block;\r\n    }\r\n\r\n    div#body-nav {\r\n        display: none;\r\n        position: absolute;\r\n        left: 0px;\r\n        right: 0px;\r\n        top: 0px;\r\n        width: initial;\r\n        z-index: 99999;\r\n    }\r\n\r\n        div#body-nav > div {\r\n            font-size: 1.2em;\r\n        }\r\n\r\n            div#body-nav > div > a,\r\n            div#body-nav > div > div > a {\r\n                display: block;\r\n                padding: 8px 0px;\r\n            }\r\n\r\n    div#body-content {\r\n        display: block;\r\n        padding: 0px 0px 10px 0px;\r\n    }\r\n\r\n    /* header\r\n    ----------------------------------------------------------*/\r\n    /*header .float-left,\r\n    header .float-right\r\n    {\r\n        float: none;\r\n    }*/\r\n\r\n    /* logo */\r\n    header .site-title {\r\n        margin: 10px;\r\n        text-align: center;\r\n    }\r\n\r\n    /* login */\r\n    #login {\r\n        font-size: .85em;\r\n        margin: 0 0 12px;\r\n        text-align: center;\r\n    }\r\n\r\n        #login ul {\r\n            margin: 5px 0;\r\n            padding: 0;\r\n        }\r\n\r\n        #login li {\r\n            display: inline;\r\n            list-style: none;\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n\r\n        #login a {\r\n            background: none;\r\n            color: #999;\r\n            font-weight: 600;\r\n            margin: 2px;\r\n            padding: 0;\r\n        }\r\n\r\n            #login a:hover {\r\n                color: #333;\r\n            }\r\n\r\n\r\n\r\n\r\n    /* menu */\r\n    nav {\r\n        margin-bottom: 5px;\r\n    }\r\n\r\n    ul#menu {\r\n        margin: 0;\r\n        padding: 0;\r\n        text-align: center;\r\n    }\r\n\r\n        ul#menu li {\r\n            margin: 0;\r\n            padding: 0;\r\n        }\r\n\r\n\r\n    /* main layout\r\n    ----------------------------------------------------------*/\r\n    .main-content,\r\n    .featured + .main-content {\r\n        background-position: 10px 0;\r\n    }\r\n\r\n    .content-wrapper {\r\n        padding-right: 10px;\r\n        padding-left: 10px;\r\n    }\r\n\r\n    .featured .content-wrapper {\r\n        padding: 10px;\r\n    }\r\n\r\n    /* page content */\r\n    /* 03-06-2017 - Sandhya - some styles in site.css conflicting with SmartAdmin styles. Site.css copied to GovEaseSite.css & offending classes have been commented out.*/\r\n    /*article, aside\r\n    {\r\n        float: none;\r\n        width: 100%;\r\n    }*/\r\n\r\n    /* ordered list */\r\n    ol.round {\r\n        list-style-type: none;\r\n        padding-left: 0;\r\n    }\r\n\r\n        ol.round li {\r\n            padding-left: 10px;\r\n            margin: 25px 0;\r\n        }\r\n\r\n            ol.round li.zero,\r\n            ol.round li.one,\r\n            ol.round li.two,\r\n            ol.round li.three,\r\n            ol.round li.four,\r\n            ol.round li.five,\r\n            ol.round li.six,\r\n            ol.round li.seven,\r\n            ol.round li.eight,\r\n            ol.round li.nine {\r\n                background: none;\r\n            }\r\n\r\n    /* features */\r\n    section.feature {\r\n        float: none;\r\n        padding: 10px;\r\n        width: auto;\r\n    }\r\n\r\n        section.feature img {\r\n            color: #999;\r\n            content: attr(alt);\r\n            font-size: 1.5em;\r\n            font-weight: 600;\r\n        }\r\n\r\n\r\n    /* footer\r\n    ----------------------------------------------------------*/\r\n    footer .float-left,\r\n    footer .float-right {\r\n        float: none;\r\n    }\r\n\r\n    footer {\r\n        text-align: center;\r\n        height: auto;\r\n        padding: 10px 0;\r\n    }\r\n\r\n        footer p {\r\n            margin: 0;\r\n        }\r\n\r\n    #myPurchaseSummary {\r\n        display: block;\r\n    }\r\n\r\n\r\n\r\n    #header-profile-info {\r\n        min-width: 100px;\r\n    }\r\n\r\n\r\n    #header-username {\r\n        min-width: 90px;\r\n    }\r\n}\r\n\r\n@media only screen and (max-width: 870px) {\r\n    #header-username {\r\n        font-size: 12px;\r\n    }\r\n}\r\n\r\n/* IPHONE 5 */\r\n@media only screen and (max-device-width : 375px) {\r\n    .ml-3, .mx-3 {\r\n        margin-left: 0rem !important;\r\n    }\r\n\r\n    #header-username {\r\n        font-size: 10px;\r\n    }\r\n\r\n    #select2-single-default-container {\r\n        width: 125px !important;\r\n    }\r\n    \r\n    #my-maximum-overbid {\r\n        font-size: 12px;\r\n    }\r\n\r\n    #parcel-percent{\r\n        display:none !important; \r\n    }\r\n}\r\n\r\n/* ALL PHONES */\r\n@media only screen and (max-device-width : 500px) {\r\n  \r\n    .auction-item-content-column1 {\r\n        display: none !important;\r\n    }\r\n\r\n    .auction-item-content-column2 {\r\n        border-top: 2px solid #8a8a8a;\r\n        padding-top: 10px;\r\n    }\r\n}\r\n\r\n\r\n/* layout a DIV like a table */\r\n.divTable {\r\n    display: table;\r\n    width: 100%;\r\n}\r\n\r\n.divTableRow {\r\n    display: table-row;\r\n}\r\n\r\n.divTableHeading {\r\n    background-color: #EEE;\r\n    display: table-header-group;\r\n    font-weight: bold;\r\n}\r\n\r\n.divTableCell, .divTableHead {\r\n    display: table-cell;\r\n    vertical-align: top;\r\n}\r\n\r\n.divTableFoot {\r\n    background-color: #EEE;\r\n    display: table-footer-group;\r\n    font-weight: bold;\r\n}\r\n\r\n.divTableBody {\r\n    display: table-row-group;\r\n}\r\n\r\n\r\n.HeaderSytle {\r\n    font-weight: bolder;\r\n    font-size: 18px;\r\n    background-color: #fafafa;\r\n    margin-bottom: 5px;\r\n    margin-left: 5px;\r\n    margin-top: 5px;\r\n}\r\n\r\n.BoxOutline {\r\n    /*border-color: #c2c2c2;\r\n    border: solid;\r\n    border-width: thin;*/\r\n    border: 1px solid #c2c2c2;\r\n}\r\n\r\n.SubRow {\r\n    padding: 0 5px 0 5px;\r\n}\r\n\r\nhr {\r\n    margin-top: 15px !important;\r\n    margin-bottom: 15px !important;\r\n}\r\n\r\n#help {\r\n    display: none;\r\n}\r\n\r\n/*Header CSS for moblie.*/\r\n#person {\r\n    display: none;\r\n}\r\n\r\n#dataTables_empty_mobile {\r\n    display: none;\r\n}\r\n\r\n#dt_paginate_mobile {\r\n    display: none;\r\n}\r\n\r\n\r\n#filter_partial_mobile {\r\n    display: none;\r\n}\r\n\r\n#auction-map-list {\r\n    display: inline-block;\r\n}\r\n.glyphicon-bell {\r\n    display: none;\r\n}\r\n\r\n.gedropdownstyle {\r\n    border: thin solid #2196f3;\r\n    -webkit-appearance: none;\r\n    font-size: 15px;\r\n    color: gray;\r\n}\r\n\r\n.nopadding {\r\n    padding: 0 !important;\r\n    margin: 0 !important;\r\n}\r\n\r\n/*@media (max-width: 975px){\r\n    nav li, ul {\r\n        background-color: #455a64 !important;\r\n        color: white !important;\r\n    }\r\n\r\n    nav ul :hover {\r\n        color: lightgoldenrodyellow;\r\n        font-weight: bold;\r\n    }\r\n}*/\r\n\r\n\r\n@media (max-width: 600px) {\r\n\r\n    #body {\r\n        padding-bottom: 25px !important;\r\n    }\r\n    /* dashboard */\r\n   #myPurchaseSummary .subheader-block {\r\n        display: block !important;\r\n        width: auto !important;\r\n   }\r\n   #myPurchaseSummary .subheader-block-hide {\r\n        display: block;\r\n        width: auto !important;\r\n   }\r\n\r\n    #dashboard {\r\n        flex-direction: column !important;\r\n        align-items: flex-start !important;\r\n    }\r\n\r\n    .subheader-title {\r\n        display: block !important;\r\n        width: auto !important;\r\n    }\r\n\r\n\r\n        .subheader-title small {\r\n            width: 100% !important;\r\n            padding-bottom: 15px;\r\n        }\r\n\r\n    #auction-map-list {\r\n        display: none;\r\n    }\r\n\r\n    #filter_partial {\r\n        display: none;\r\n    }\r\n\r\n    #filter_partial_mobile {\r\n        display: inline;\r\n    }\r\n\r\n    #dt_paginate {\r\n        display: none;\r\n    }\r\n\r\n    #dt_paginate_mobile {\r\n        display: inline;\r\n    }\r\n\r\n    #beamerText {\r\n        display: none !important;\r\n    }\r\n\r\n    /* removed as part of fix for GEMP 321.5*/\r\n/*    #HeaderSignOut {\r\n        padding-right: 45px !important;\r\n    }*/\r\n\r\n/* GEMP 321.5 */\r\n\r\n    .header-icon-mobile-container {\r\n        max-width: 100px;\r\n    }\r\n\r\n    .header-icon:not(.btn){\r\n        min-width:2rem;\r\n        text-align:center;\r\n        overflow:visible;\r\n    }\r\n\r\n\r\n\r\n\r\n\r\n\r\n    #logout {\r\n        padding-left: 25px;\r\n    }\r\n\r\n    .fa-sign-out {\r\n        padding-right: 25px;\r\n        font-size: 25px;\r\n    }\r\n\r\n    #help.glyphicon-comment {\r\n        font-size: 18px;\r\n        padding-right: 25px;\r\n        color: white;\r\n    }\r\n\r\n    #person.glyphicon-user {\r\n        font-size: 18px;\r\n        padding-right: 10px;\r\n    }\r\n\r\n    .glyphicon-bell {\r\n        display: inline;\r\n        top: 2px;\r\n        font-size: 18px;\r\n        padding-right: 10px;\r\n        color: white\r\n    }\r\n\r\n    #help {\r\n        display: inline;\r\n    }\r\n\r\n    #beacon-container {\r\n        visibility: hidden;\r\n    }\r\n}\r\n@media(max-width:850px) {\r\n    #flex-icon-container {\r\n        display: flex;\r\n        flex-direction: row;\r\n    }\r\n\r\n        #flex-icon-container > .header-icon-mobile-flip1 {\r\n            order: 2;\r\n        }\r\n\r\n        #flex-icon-container > .header-icon-mobile-flip2 {\r\n            order: 1;\r\n        }\r\n\r\n        #flex-icon-container > .header-icon-mobile-flip3 {\r\n            order: 3;\r\n        }\r\n}\r\n\r\n@media (min-width: 601px) {\r\n    #beacon-container {\r\n        visibility: visible !important;\r\n    }\r\n}\r\n\r\n\r\n@media (min-width: 991px) {\r\n    #LoginRightBorder {\r\n        border-right-width: 1px !important;\r\n        border-right-color: black !important;\r\n        border-right-style: solid !important;\r\n    }\r\n}\r\n\r\n@media (max-width: 990px) {\r\n    #LoginRightBorder {\r\n        border-right-width: unset !important;\r\n    }\r\n}\r\n/*end header for moblie*/\r\n\r\n/*Start of pager counter for grid form mobile.*/\r\n@media (max-width: 850px) {\r\n    .GridPager {\r\n        display: list-item !important;\r\n        background-color: #2c3e50 !important;\r\n    }\r\n\r\n    #GridPagerCount {\r\n        text-align: center !important;\r\n    }\r\n\r\n    #GridPagerWordsNextBack {\r\n        display: unset !important;\r\n    }\r\n\r\n    #openLoginModal {\r\n        display: none;\r\n    }\r\n\r\n    #userid {\r\n        display: none;\r\n    }\r\n\r\n    #person {\r\n        display: inline;\r\n    }\r\n\r\n    #dataTables_empty {\r\n        display: none;\r\n    }\r\n\r\n    #dataTables_empty_mobile {\r\n        display: inline;\r\n    }\r\n\r\n\r\n    .time-left {\r\n        width: 100%\r\n    }\r\n\r\n    .time-left-header {\r\n        float: left;\r\n        padding-left: calc(50% - 45px) !important;\r\n    }\r\n\r\n    .time-left-content {\r\n        float: left;\r\n        padding-left: 15px !important;\r\n    }\r\n\r\n    .live-message {\r\n        font-size: 1.1em !important;\r\n    }\r\n\r\n    .live-message-info {\r\n        font-size: 1.1em !important;\r\n    }\r\n\r\n    .live-message-error {\r\n        font-size: 1.1em !important;\r\n    }\r\n\r\n    .live-message-success {\r\n        font-size: 1.1em !important;\r\n    }\r\n\r\n    .live-message-warning {\r\n        font-size: 1.1em !important;\r\n    }\r\n\r\n    .panel > .panel-hdr.flash-message-success {\r\n        font-size: 1.1em !important;\r\n    }\r\n\r\n    .panel > .panel-hdr.flash-message-error {\r\n        font-size: 1.1em !important;\r\n    }\r\n\r\n    .panel > .panel-hdr.flash-message-warning {\r\n        font-size: 1.1em !important;\r\n    }\r\n\r\n    .panel > .panel-hdr.flash-message-info {\r\n        font-size: 1.1em !important;\r\n    }\r\n}\r\n\r\n/*End of pager counter for grid form moblie.*/\r\n/* Start of tool tip */\r\n.tooltip {\r\n    position: relative;\r\n    display: inline-block;\r\n    opacity: unset;\r\n    font-family: inherit;\r\n    font-size: inherit;\r\n    z-index: 1151 !important;\r\n}\r\n\r\n.tooltip .tooltiptext {\r\n    display: none;\r\n    width: 120px;\r\n    background-color: white;\r\n    color: black;\r\n    font-size: 12px;\r\n    text-align: center;\r\n    border-radius: 6px;\r\n    border-style: solid;\r\n    border-width: 1px;\r\n    border-color: black;\r\n    padding: 5px 0;\r\n    /* Position the tooltip */\r\n    position: absolute;\r\n    z-index: 1;\r\n}\r\n\r\n/* GEMP-748*/\r\n.tooltip:hover .tooltiptext  {\r\n    display: block;\r\n}\r\n\r\n.tooltip .tooltiptextblue {\r\n    display: none;\r\n    width: max-content;\r\n    background-color: #2980b9;\r\n    color: white;\r\n    font-size: 12px;\r\n    text-align: center;\r\n    border-radius: 6px;\r\n    border-style: solid;\r\n    border-width: 1px;\r\n    padding: 5px;\r\n    padding-left: 10px;\r\n    padding-right: 10px;\r\n    /* Position the tooltip */\r\n    position: absolute;\r\n    z-index: 1;\r\n}\r\n\r\n.tooltip:hover .tooltiptextblue {\r\n    display: inline-block;\r\n}\r\n\r\n.tooltip-right {\r\n    top: -5px;\r\n    left: 125%;\r\n}\r\n\r\n.tooltip-right::after {\r\n    content: \"\";\r\n    position: relative;\r\n    top: 50%;\r\n    right: 100%;\r\n    margin-top: -5px;\r\n    border-width: 5px;\r\n    border-style: solid;\r\n    border-color: transparent #2980b9 transparent transparent;\r\n}\r\n\r\n/* End of tool tip */\r\n\r\n/* START - GEMP-736 - Tooltip title */\r\n#tooltiptitle {\r\n    text-align: center;\r\n    background-color: #b5d8ef;\r\n    color: #164666;\r\n    border-radius: 6px;\r\n    position: absolute;\r\n    z-index: 100;\r\n    padding: 10px;\r\n}\r\n\r\n#tooltiptitle::after { /* triangle decoration */\r\n    width: 0;\r\n    height: 0;\r\n    border-left: 10px solid transparent;\r\n    border-right: 10px solid transparent;\r\n    border-top: 10px solid #b5d8ef;\r\n    content: '';\r\n    position: absolute;\r\n    left: 50%;\r\n    bottom: -10px;\r\n    margin-left: -10px;\r\n}\r\n\r\n#tooltiptitle.top::after {\r\n    border-top-color: transparent;\r\n    border-bottom: 10px solid #b5d8ef;\r\n    top: -20px;\r\n    bottom: auto;\r\n}\r\n\r\n#tooltiptitle.left::after {\r\n    left: 10px;\r\n    margin: 0;\r\n}\r\n\r\n#tooltiptitle.right::after {\r\n    right: 10px;\r\n    left: auto;\r\n    margin: 0;\r\n}\r\n/* END - GEMP-736 - Tooltip title */\r\n\r\n.govease_logo {\r\n    width: 210px;\r\n    padding-top: 20px;\r\n    padding-left: 60px;\r\n}\r\n\r\n/* GEMP 329 styling for modal logo */\r\n.govease_logo_blue {\r\n    width: 250px;\r\n}\r\n\r\n/* GotBootstrap Smart Admin V451 Overrides */\r\n\r\n\r\n/* Override default behavior of hover on left side nav */\r\n/* GEMP 321.4 Create new rules with default left rem size */\r\n.nav-function-hidden:not(.nav-function-top) .page-sidebar:hover {\r\n    left: -16.25rem;\r\n}\r\n/* End override default behavior of hover on left side nav */\r\n/* End GotBootstrap Smart Admin V451 Overrides */\r\n\r\n/* GEMP 321.2.3 Override default select 2 inheriting too light of a color for ddl group names */\r\n.select2-container--default .select2-results__group {\r\n    padding: 0.5rem 0;\r\n    color: black;\r\n    font-weight: bold;\r\n}\r\n/* END GEMP 321.2.3 Override default select 2 inheriting too light of a color for ddl group names */\r\n/* GEMP 329 remove text decoration from a target from template */\r\na[target]:not(.btn) {\r\n    text-decoration: none !important;\r\n}\r\n/* END GEMP 329 remove text decoration from a target */\r\n\r\n/* GEMP 327 login page changes used in conditionally set classes to hide bootstrap panel design elements */\r\n/* this was removed 7/10/20 */\r\n/*.panel-border-hidden {\r\n    max-width: 30rem;\r\n    padding-bottom: 2rem;\r\n}*/\r\n/*END GEMP 327 Login panel changes made late 7/9/20 */\r\n/* Login pages not using panel - smaller div design to hold contents - revised 7/27/20 to remove .login-container */\r\n.login-wrapper {\r\n    text-align: center;\r\n}\r\n\r\n.login-inner {\r\n    display: inline-block;\r\n    margin: 0 auto;\r\n    width: 20rem;\r\n}\r\n/* End -Login pages not using panel - smaller div design to hold contents */\r\n\r\n/* Registration Classes */\r\n@media (min-width: 991px) {\r\n    /* my registration */\r\n\r\n    #myRegistration-subheader-left {\r\n        margin: 0rem 1rem 0rem 0rem;\r\n        float: left;\r\n    }\r\n\r\n        #myRegistration-subheader-left > small {\r\n            display: block;\r\n        }\r\n\r\n    #myRegistration-subheader-right {\r\n        float: left;\r\n    }\r\n\r\n    .registrations-w50p {\r\n        width: 50%;\r\n    }\r\n    /* registrations */\r\n    .registration-sidewall-right-padding {\r\n        padding: 0 10rem 0 0;\r\n    }\r\n\r\n    .registration-button-right {\r\n        float: right;\r\n        width: 7rem;\r\n    }\r\n\r\n    .registration-upload-right {\r\n        width: 100%;\r\n        float: right;\r\n        cursor: pointer;\r\n        max-width: 400px;\r\n    }\r\n\r\n    #registration-table-wrapper > div > table {\r\n        float: right;\r\n    }\r\n\r\n    .registration-signnow-right {\r\n        float: right;\r\n        cursor: pointer;\r\n    }\r\n\r\n    .registration-signnow-btn-wrap {\r\n        display: inline-block;\r\n        width: 100%;\r\n    }\r\n\r\n    .registraion-signnow-btn-inner {\r\n        float: right;\r\n    }\r\n\r\n    .registration-signnow-btn {\r\n        float: right;\r\n        width: 7rem;\r\n    }\r\n\r\n    .modal-content-extend {\r\n        width: auto\r\n    }\r\n}\r\n\r\n@media (max-width: 990px) {\r\n    /* my registration */\r\n    #myRegistration-subheader-left {\r\n        margin: 0rem 0rem 1em 0rem;\r\n    }\r\n\r\n        #myRegistration-subheader-left > small {\r\n            display: block;\r\n        }\r\n\r\n    #myRegistration-subheader-right {\r\n        display: block;\r\n    }\r\n    /* registrations */\r\n    .registration-button-right {\r\n        width: 7rem;\r\n    }\r\n\r\n    .registrations-w50p {\r\n        width: 100%;\r\n    }\r\n\r\n    .registration-mobile-description {\r\n        max-width: 500px;\r\n    }\r\n\r\n    .registration-upload-right {\r\n        max-width: 500px;\r\n        float: left;\r\n        display: block;\r\n        cursor: pointer;\r\n        padding-left:20px;\r\n    }\r\n\r\n    #registration-table-wrapper {\r\n        max-width: 500px;\r\n    }\r\n\r\n    .registration-signnow-right {\r\n        cursor: pointer;\r\n        padding-left:20px;\r\n    }\r\n\r\n    .registration-signnow-btn-wrap {\r\n        padding-left: 10px;\r\n    }\r\n\r\n    .registraion-signnow-btn {\r\n        width: 7rem;\r\n    }\r\n\r\n    .tooltip .tooltiptextblue{\r\n        max-width:300px;\r\n    }\r\n\r\n}\r\n\r\n@media (max-width: 601px) {\r\n\r\n    #select2-single-default-container {\r\n        width: 150px !important;\r\n    }\r\n    /* registrations */\r\n\r\n    .registration-mobile-description {\r\n        max-width: 300px;\r\n    }\r\n\r\n    .registration-upload-right {\r\n        max-width: 300px;\r\n        float: left;\r\n        cursor: pointer;\r\n    }\r\n\r\n    #registration-table-wrapper {\r\n        max-width: 300px;\r\n    }\r\n\r\n    .tab-content-mobile{\r\n        max-width:300px;\r\n        overflow-x:auto;\r\n    }\r\n\r\n    .tooltip .tooltiptextblue {\r\n        position: sticky;\r\n    }\r\n\r\n    .tooltip-right {\r\n        top: 0;\r\n        left: 0;\r\n    }\r\n}\r\n/* End - Registration Classes*/\r\n\r\n/* GEMP 362 - match all header items to work like non buttons in highlighting on hover \r\n    made important to override beemer logic that loads late\r\n*/\r\n\r\n/* GEMP 336 adjustment to remove padding when using mobile view\r\n\r\n*/\r\n/* GEMP 379 float mobile contents including button to the left, add small uniform padding to title */\r\ntable.dataTable > tbody.mobile-left-collapsable-reduce-title > tr.child span.dtr-title {\r\n    display: inline-block;\r\n    min-width: inherit; /* remove the min-width property so the buttons will move left instead of having a column for the title that is fixed size and the alignment of the data column will be correct*/\r\n    font-weight: bold;\r\n    padding-right:.5rem;\r\n}\r\n/* end GEMP 379*/\r\n\r\n\r\n\r\n    @media (min-width: 767px) {\r\n        .no-padding-mobile-b10 {\r\n            padding-top: 7rem;\r\n            padding-bottom: 1rem;\r\n            padding-left: 1rem;\r\n            margin: auto;\r\n            width: inherit;\r\n        }\r\n    }\r\n\r\n    @media (max-width:766px) {\r\n        .no-padding-mobile-b10 {\r\n            padding-left: 1rem;\r\n            padding-top: 1rem;\r\n            padding-bottom: 1rem;\r\n            margin: auto;\r\n            width: inherit;\r\n        }\r\n    }\r\n\r\n    .hoverable-header:hover {\r\n    color: #404040 !important;\r\n    opacity: 1 !important;\r\n}\r\n\r\n/* GEMP 368-fix Make datatable buttons use custom class to center them in normal view and left align in compacted view */\r\n\r\n.button-dtable {\r\n    margin: auto;\r\n    display: block;\r\n}\r\n\r\n.dtr-data .button-dtable {\r\n    float: left;\r\n}\r\n\r\n\r\n/* GEMP 333 handle template use of span in file load button groupings */\r\n.div-like-btn-primary {\r\n    color: #fff;\r\n    background-color: #2980b9;\r\n    border-color: #2980b9;\r\n}\r\n\r\n    .div-like-btn-primary:hover {\r\n        color: #fff;\r\n        background-color: #226a9a;\r\n        border-color: #20638f;\r\n    }\r\n\r\n/* Preview Auction effects*/\r\ntable.dataTable tr.tied {\r\n    background-color: #ffc241 !important;\r\n}\r\n    table.dataTable tr.tied:hover {\r\n        background-color: #ffc241 !important;\r\n    }\r\n\r\ntable.dataTable tr.nobid {\r\n    /*background-color: #FFFFFF !important;*/\r\n}\r\n\r\ntable.dataTable tr.hover {\r\n    background-color: rgba(186, 208, 243, 0.50) !important;\r\n}\r\n\r\ntable.dataTable tr.winning {\r\n    background-color: rgba(52, 250, 135, 0.50) !important;\r\n}\r\n\r\ntable.dataTable tr.loosing {\r\n    background-color: rgba(250, 77, 77, 0.50) !important;\r\n}\r\n\r\n    table.dataTable tr.loosing:hover {\r\n        background-color: rgba(237, 75, 75, 0.50) !important;\r\n    }\r\n\r\ntable.dataTable tr.winning:hover {\r\n    background-color: rgba(53, 235, 129, 0.50) !important;\r\n}\r\n\r\ntable.dataTable tr.nobid:hover {\r\n    background-color: rgba(186, 208, 243, 0.50) !important;\r\n}\r\n\r\n    table.dataTable tr.nobid:hover td.sorting_1 {\r\n        background-color: rgba(186, 208, 243, 0.00) !important;\r\n    }\r\n\r\n\r\ndiv .winning-light {\r\n    background-color: rgba(52, 250, 135, 0.20) !important;\r\n   \r\n}\r\n\r\ndiv .loosing-light {\r\n    background-color: rgba(250, 77, 77, 0.20) !important;\r\n   \r\n}\r\n\r\n\r\ndiv .winning-light:hover > div {\r\n    background-color: rgba(53, 235, 129, 0.20) !important;\r\n   \r\n}\r\n\r\ndiv .loosing-light:hover > div {\r\n    background-color: rgba(237, 75, 75, 0.20) !important;\r\n   \r\n}\r\ntable.dataTable tr.odd {\r\n    background-color: white;\r\n    border: 2px #333;\r\n}\r\n\r\ntable.dataTable tr.even {\r\n    background-color: white;\r\n    border: 2px #333;\r\n}\r\n\r\n    table.dataTable tr.even td.sorting_1 {\r\n        background-color: white;\r\n    }\r\n\r\ntable.dataTable tr.odd td.sorting_1 {\r\n    background-color: white;\r\n}\r\n\r\n\r\ntable.dataTable > tbody > tr.child span.dtr-title {\r\n    padding-right: 10px;\r\n}\r\n\r\n\r\ntable.boxBorder {\r\n    border: 2px solid #ddd\r\n}\r\n\r\n.alignDollar {\r\n    text-align: right;\r\n    padding-right: 30px !important;\r\n}\r\n\r\n\r\n\r\n.sorted,\r\n.notsorted {\r\n    padding-right: 30px;\r\n    cursor: pointer;\r\n    position: relative;\r\n}\r\n\r\n    .sorted:before,\r\n    .sorted:after,\r\n    .notsorted:before,\r\n    .notsorted:after {\r\n        position: absolute;\r\n        bottom: 0.1em;\r\n        display: block;\r\n        opacity: 0.3;\r\n    }\r\n\r\n    .sorted:before,\r\n    .notsorted:before {\r\n        right: 1em;\r\n        content: \"\\2191\";\r\n    }\r\n\r\n    .sorted:after,\r\n    .notsorted:after {\r\n        right: 0.5em;\r\n        content: \"\\2193\";\r\n    }\r\n\r\n\r\n\r\n\r\n    /* arrow to indicate ASC Sort Order */\r\n    .sorted[data-order-by][data-order-desc=\"0\"]:after,\r\n    .sorted[data-order-by][data-order-desc=\"1\"]:after {\r\n        /*content: '\\25BC';'\\2304';*/ /*'\\2c5';*/ /*'\\25BC';*/\r\n        right: 0.5rem !important;\r\n        content: \"\\f176\";\r\n        font-size: 14px;\r\n        font-family: 'Font Awesome 5 Pro';\r\n    }\r\n\r\n    .sorted[data-order-by][data-order-desc=\"0\"]:after {\r\n        opacity: 1;\r\n    }\r\n    /* arrow to indicate DESC Sort Order */\r\n    .sorted[data-order-by][data-order-desc=\"0\"]:before,\r\n    .sorted[data-order-by][data-order-desc=\"1\"]:before {\r\n        /*content: '\\25B2';'\\2303';*/ /*'\\2c4';*/ /*'\\25B2';*/\r\n        right: 1rem !important;\r\n        content: \"\\f175\";\r\n        font-size: 14px;\r\n        font-family: 'Font Awesome 5 Pro';\r\n    }\r\n\r\n    .sorted[data-order-by][data-order-desc=\"1\"]:before {\r\n        opacity: 1;\r\n    }\r\n\r\ntable.dataTable.dtr-inline.collapsed > tbody > tr[role=\"row\"] > td.dtr-control, table.dataTable.dtr-inline.collapsed > tbody > tr[role=\"row\"] > th.dtr-control {\r\n    padding-left: 0px;\r\n}\r\n\r\n\r\n.popover {\r\n    max-width: 350px !important;\r\n}\r\n\r\n.btnpadright {\r\n    margin-right: 0.45rem !important;\r\n}\r\n\r\n/* place bid control*/\r\n\r\n.input-group {\r\n    flex-wrap: nowrap;\r\n}\r\n\r\n    .input-group .form-control {\r\n        min-width: 65px;\r\n        max-width: 125px;\r\n    }\r\n\r\n    .input-group .input-group-append .btn :not(.btn-icon) {\r\n        min-width: 95px;\r\n    }\r\n\r\n\r\ntable.dataTable tr.odd > td {\r\n    padding-top: 20px !important;\r\n}\r\n\r\ntable.dataTable tr.even > td {\r\n    padding-top: 20px !important;\r\n}\r\n\r\n\r\n/* live bidding info and errors */\r\n.live-message {\r\n    color: white;\r\n    font-size: 1.3em;\r\n    font-weight: bold;\r\n    padding: 4px 4px;\r\n    background-color: #2472a4;\r\n}\r\n\r\n.live-message-info {\r\n    color: white;\r\n    font-size: 1.3em;\r\n    font-weight: bold;\r\n    padding: 4px 4px;\r\n    background-color: #1A1AD0;\r\n}\r\n\r\n.live-message-error {\r\n    color: white;\r\n    font-size: 1.3em;\r\n    font-weight: bold;\r\n    padding: 4px 4px;\r\n    background-color: #e74c3c;\r\n}\r\n\r\n.live-message-success {\r\n    color: white;\r\n    font-size: 1.3em;\r\n    font-weight: bold;\r\n    padding: 4px 4px;\r\n    background-color: #1dc9b7;\r\n}\r\n\r\n.live-message-warning {\r\n    color: white;\r\n    font-size: 1.3em;\r\n    font-weight: bold;\r\n    padding: 4px 4px;\r\n    background-color: #ffc241;\r\n}\r\n\r\n.panel > .panel-hdr .auction-item-content-header-status,\r\n.panel > .panel-hdr .auction-item-content-header-flash {\r\n    padding-left: 20px;\r\n}\r\n\r\n.panel > .panel-hdr.flash-message-success {\r\n    background-color: #1dc9b7;\r\n    font-size: 1.3em;\r\n}\r\n\r\n.panel > .panel-hdr.flash-message-error {\r\n    background-color: #e74c3c;\r\n    font-size: 1.3em;\r\n}\r\n\r\n.panel > .panel-hdr.flash-message-warning {\r\n    background-color: #ffc241;\r\n    font-size: 1.3em;\r\n}\r\n\r\n.panel > .panel-hdr.flash-message-info {\r\n    background-color: #1A1AD0;\r\n    font-size: 1.3em;\r\n}\r\n\r\n\r\n.panel > .panel-hdr .auction-item-content-header-flash {\r\n    display: none;\r\n}\r\n\r\n.panel > .panel-hdr.flash-message-success .auction-item-content-header-flash,\r\n.panel > .panel-hdr.flash-message-error .auction-item-content-header-flash,\r\n.panel > .panel-hdr.flash-message-warning .auction-item-content-header-flash,\r\n.panel > .panel-hdr.flash-message-info .auction-item-content-header-flash {\r\n    display: inline;\r\n}\r\n\r\n.panel > .panel-hdr.flash-message-success .auction-item-content-header-status,\r\n.panel > .panel-hdr.flash-message-error .auction-item-content-header-status,\r\n.panel > .panel-hdr.flash-message-warning .auction-item-content-header-status,\r\n.panel > .panel-hdr.flash-message-info .auction-item-content-header-status {\r\n    display: none;\r\n}\r\n\r\n.panel-content > .layout-row {\r\n    display: table-row;\r\n}\r\n\r\n    .panel-content > .layout-row > .layout-col {\r\n        display: table-cell;\r\n        vertical-align: top;\r\n    }\r\n\r\ntable.dataTable > tbody > tr.child ul.dtr-details > li {\r\n    display: flex;\r\n    flex-direction: row;\r\n}\r\n\r\n/* User Profile allow wrapping of text in text box\r\n\r\n*/\r\n/*.select2.narrow {\r\n    width: 200px;\r\n}*/\r\n\r\n.wrap.select2-selection--single {\r\n    height: 100%;\r\n}\r\n\r\n.select2-container .wrap.select2-selection--single .select2-selection__rendered {\r\n    word-wrap: break-word;\r\n    text-overflow: inherit;\r\n    white-space: normal;\r\n}\r\n.winning-font {\r\n    color: #45a197;\r\n    font-weight: bolder;\r\n}\r\n\r\n.losing-font {\r\n    color: #bf2718;\r\n    font-weight:bolder;\r\n}\r\n\r\n/* GEMP 321 styling fix to make sign out flow to one or two lines depending on screen size. */\r\n@media (min-width: 767px) {\r\n    #signoutBreak {\r\n        display: none;\r\n    }\r\n}\r\n/* GEMP 412 make footer always visibile even in mobile, wanted to smooth out text and break at 